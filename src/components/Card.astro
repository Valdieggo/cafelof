---
interface Props {
	title: string;
	href: string;
}

const { href, title } = Astro.props;
---

<li class="link-card">
	<a href={href}>
		<img src={'public/whatsapp-icon-design.png'} alt={title} class="icon" />
		<h2>
			{title}
		</h2>
	</a>
</li>
<style>
	.link-card {
		list-style: none;
		display: flex;
		align-items: center;
		padding: 2px;
		margin: 5px;
		background-image: none;
		background-size: 400%;
		border-radius: 7px;
		background-position: 100%;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.link-card > a {
		display: flex;
		flex-direction: row;
		align-items: center;
		width: 100%;
		text-decoration: none;
		line-height: 1.4;
		padding: 10px;
		border-radius: 8px;
		color: white;
		background-color: #25d366;
	}
	.icon {
		width: 50px;
		height: 50px;
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		font-family: 'Helvetica', sans-serif;
	}
	p {
		margin-top: 0.5rem;
		margin-bottom: 0;
	}
	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: linear-gradient(90deg, rgba(18, 140, 126, 1) 0%, rgba(18, 140, 126, 0.5) 100%);
	}
</style>
